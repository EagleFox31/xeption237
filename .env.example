VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Smart Troc — analyse photo (activée par défaut ; "false" pour désactiver)
VITE_ENABLE_TROC_AI=true

# Super admin / créateur (accès /studio — emails séparés par virgule)
VITE_SUPER_ADMIN_EMAILS=you@example.com

# ─── Scripts Node locaux uniquement (jamais préfixe VITE_) ───────────────────
# Les appels IA du site passent par les Edge Functions Supabase (voir docs/engineering/SECRETS_ET_VARIABLES.md).

DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=

# Enrichissement catalogue (scripts/batch-enrich-*.mjs, product-ingestion-funnel.mjs)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Optionnel — batch-enrich avec --provider=gemini
GEMINI_API_KEY=
BATCH_ENRICH_MODEL=gemini-2.5-flash

# Optionnel — scripts/test-openrouter-vision.mjs (prod : OPENROUTER_API_KEY sur Supabase)
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# IndexNow (notification Bing/Yandex)
INDEXNOW_KEY=
