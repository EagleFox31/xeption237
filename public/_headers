# Configuration des En-têtes HTTP Edge Cache pour Xeption Network
# Compatible Cloudflare Pages, Netlify, et serveurs Web Edge

# 1. Assets immuables (hashés et logos statiques) : Cache longue durée (1 an)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/logos/*
  Cache-Control: public, max-age=31536000, immutable

/mascot/*
  Cache-Control: public, max-age=31536000, immutable

/logo_marques_africaines/*
  Cache-Control: public, max-age=31536000, immutable

# 2. Images locales et bannières (30 jours + stale-while-revalidate 1 jour)
/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# 3. HTML et Service Worker : Revalidation immédiate (évite les caches bloquants lors des mises à jour)
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw-admin.js
  Cache-Control: public, max-age=0, must-revalidate
