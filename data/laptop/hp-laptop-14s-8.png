presentation\",\"children\":[\"$\",\"div\",null,{\"style\":{\"display\":\"contents\"},\"children\":[\"$\",\"picture\",null,{\"className\":\"article img-wrapper lazy\",\"data-image-key\":\"2087511-5184-5184-3888-3888\",\"data-lazy\":\"{\\\"imageId\\\":2087511,\\\"className\\\":\\\"article\\\",\\\"mobileWidth\\\":5184,\\\"mobileHeight\\\":3888,\\\"desktopWidth\\\":5184,\\\"desktopHeight\\\":3888,\\\"disableRadius\\\":false,\\\"extension\\\":\\\"jpeg\\\",\\\"title\\\":\\\"HP 14s-16\\\",\\\"maxWidth\\\":5184}\",\"style\":{\"--iwm\":\"768px\",\"--ihm\":\"576px\",\"--iwt\":\"1024px\",\"--iht\":\"768px\",\"--iwd\":\"5184px\",\"--ihd\":\"3888px\"},\"children\":\"$111\"}]}]}],null]}],null]}]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"b1:[\"$\",\"div\",\"enyqum\",{\"className\":\"grid-default\",\"children\":[\"$\",\"$1\",\"enyqum\",{\"children\":[[\"$\",\"div\",null,{\"suppressHydrationWarning\":true,\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"div-breakable\\\"\u003e\u003c/div\u003e\"}}],[\"$\",\"div\",null,{\"className\":\"row-wrapper row\",\"children\":[[\"$\",\"div\",\"zbhcq3\",{\"className\":\"slate-content col-slate-12\",\"children\":[[\"$\",\"$1\",\"0\",{\"children\":[[\"$\",\"$Lc9\",null,{\"className\":\"$undefined\",\"children\":[[\"Dans un contexte d’utilisation polyvalente, mêlant bureautique et multimédia léger, nous avons réussi à aller légèrement au-delà des 6 heures. Une prestation là aussi très loin de nous convaincre quand la majorité des modèles concurrents parvient au minimum à tutoyer les 8 heures d’autonomie. Faire toute une journée de travail sur le 14s sans passer par le chargeur est donc tout simplement impossible.\"]]}],[\"$\",\"div\",null,{\"suppressHydrationWarning\":true,\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"div-breakable\\\"\u003e\u003c/div\u003e\"}}]]}],[\"$\",\"$1\",\"1\",{\"children\":[[\"$\",\"$Lc9\",null,{\"className\":\"$undefined\",\"children\":[[\"La recharge se fait pour sa part en un peu plus de 1 heure 40 minutes à l’aide d’un chargeur 45 W avec connectique propriétaire. Et pas question ici de passer par un quelconque chargeur USB-C pour plus de praticité, la recharge par ce biais n’est tout simplement pas supportée.\"]]}],null]}]]}]]}]]}]}]\n114:[\"$\",\"img\",null,{\"src\":\"//pic.clubic.com/3dad1e2a2087493/5184x3888/smart/hp-14s-10.jpg\",\"alt\":\"© Nathan Le Gohlisse pour Clubic\",\"width\":5184,\"height\":3888,\"loading\":\"lazy\",\"className\":\" radius\"}]\n113:[[\"$\",\"div\",null,{\"className\":\"image-loading\",\"children\":[\"$\",\"svg\",null,{\"className\":\"image-clip\",\"width\":50,\"height\":50,\"viewBox\":\"0 0 93.51 93.51\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"children\":[[\"$\",\"circle\",null,{\"fill\":\"#ff0037\",\"cx\":\"46.75\",\"cy\":\"46.75\",\"r\":\"46.75\"}],[\"$\",\"path\",null,{\"fill\":\"var(--theme-palette-white)\",\"d\":\"M46.75,63.47a16.71,16.71,0,1,1,10-30.08A6.23,6.23,0,0,0,65,32.85l5.78-5.79a31,31,0,1,0,0,39.39L65,60.66a6.21,6.21,0,0,0-8.14-.56A16.69,16.69,0,0,1,46.75,63.47Z\"}]]}]}],[\"$\",\"noscript\",null,{\"children\":\"$114\"}]]\nb2:[\"$\",\"div\",\"7uq902\",{\"children\":[\"$\",\"$1\",\"7uq902\",{\"children\":[[\"$\",\"div\",null,{\"suppressHydrationWarning\":true,\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"div-breakable\\\"\u003e\u003c/div\u003e\"}}],[\"$\",\"div\",null,{\"className\":\"row-wrapper row\",\"children\":[[\"$\",\"div\",\"28uhbt\",{\"children\":[[\"$\",\"$L90\",null,{\"className\":\"image-content\",\"images\":[{\"id\":2087493,\"width\":5184,\"height\":3888}],\"children\":[[\"$\",\"span\",null,{\"onClick\":\"$undefined\",\"onKeyDown\":\"$undefined\",\"onDoubleClick\":null,\"role\":\"presentation\",\"children\":[\"$\",\"div\",null,{\"style\":{\"display\":\"contents\"},\"children\":[\"$\",\"picture\",null,{\"className\":\"article img-wrapper lazy\",\"data-image-key\":\"2087493-5184-5184-3888-3888\",\"data-lazy\":\"{\\\"imageId\\\":2087493,\\\"className\\\":\\\"article\\\",\\\"mobileWidth\\\":5184,\\\"mobileHeight\\\":3888,\\\"desktopWidth\\\":5184,\\\"desktopHeight\\\":3888,\\\"disableRadius\\\":false,\\\"extension\\\":\\\"jpeg\\\",\\\"title\\\":\\\"HP 14s-10\\\",\\\"maxWidth\\\":5184}\",\"style\":{\"--iwm\":\"768px\",\"--ihm\":\"576px\",\"--iwt\":\"1024px\",\"--iht\":\"768px\",\"--iwd\":\"5184px\",\"--ihd\":\"3888px\"},\"children\":\"$113\"}]}]}],[\"$\",\"$Lc8\",null,{\"children\":\"© Nathan Le Gohlisse pour Clubic\"}]]}],null]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"b3:[\"$\",\"div\",\"lns2cp\",{\"className\":\"grid-default\",\"children\":[\"$\",\"$1\",\"lns2cp\",{\"children\":[[\"$\",\"div\",null,{\"suppressHydrationWarning\":true,\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"div-breakable\\\"\u003e\u003c/div\u003e\"}}],[\"$\",\"div\",null,{\"className\":\"row-wrapper row\",\"children\":[[\"$\",\"div\",\"of97h6\",{\"className\":\"slate-content col-slate-12\",\"children\":[[\"$\",\"$1\",\"0\",{\"children\":[[null,[\"$\",\"$Lde\",null,{\"id\":\"index-5\",\"className\":\"$undefined\",\"children\":[[\"Audio : circulez, y’a rien d’intéressant à entendre\"]]}]],null]}],[\"$\",\"$1\",\"1\",{\"children\":[[\"$\",\"$Lc9\",null,{\"className\":\"$undefined\",\"children\":[[\"Le 14s embarque deux petits haut-parleurs ayant le bon goût d’êtres installés au-dessus du clavier… et donc orientés vers l'utilisateur. Sans être réellement mauvais, ces derniers assurent le service minimum pour regarder un film ou une vidéo sans écouteurs. Nous leur reconnaissons le mérite de ne pas saturer à plein volume et d’offrir un son relativement clair. Cependant, c'est à peu près tout : les aigus sont en retrait, au même titre que les graves, et les médiums prennent toute la place pour faire primer une bonne restitution des voix sur le reste.\"]]}],[\"$\",\"div\",null,{\"suppressHydrationWarning\":true,\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"div-breakable\\\"\u003e\u003c/div\u003e\"}}]]}],[\"$\",\"$1\",\"2\",