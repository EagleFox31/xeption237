mage/webp" srcSet="//pic.clubic.com/20e3f4452087466/1024x768/smart/hp-14s-1.webp 1x, //pic.clubic.com/722159422087466/1536x1152/smart/hp-14s-1.webp 2x"/><source media="(min-width: 1025px)" sizes="5184px" type="image/webp" srcSet="//pic.clubic.com/a3de6b4f2087466/1600x1200/smart/hp-14s-1.webp 1x"/><source media="(max-width: 768px)" sizes="768px" srcSet="//pic.clubic.com/13365ed42087466/768x576/smart/hp-14s-1.jpg 2x, //pic.clubic.com/53b8d4192087466/1152x864/smart/hp-14s-1.jpg 3x"/><source media="(min-width: 769px) and (max-width: 1024px)" sizes="1024px" srcSet="//pic.clubic.com/efa07c372087466/1024x768/smart/hp-14s-1.jpg 1x, //pic.clubic.com/00331ece2087466/1536x1152/smart/hp-14s-1.jpg 2x"/><source media="(min-width: 1025px)" sizes="5184px" srcSet="//pic.clubic.com/bc1584822087466/1600x1200/smart/hp-14s-1.jpg 1x"/><img src="//pic.clubic.com/c06639052087466/5184x3888/smart/hp-14s-1.jpg" alt="© Nathan Le Gohlisse pour Clubic" loading="eager" class="radius"/></picture></div></span><figcaption class="pvih72-0 iKYEYn">© Nathan Le Gohlisse pour Clubic</figcaption></div></div></div></div><div class="grid-default"><div><div class="div-breakable"></div></div><div class="row-wrapper row"><div class="slate-content col-slate-12"><p class="sc-9e1vpx-0 jVoltE"><strong>Lancer un </strong><a href="/pc-portable/article-895443-1-pc-portables-13-pouces-comparatif-meilleurs-modeles-2020.html" class="un-styled-linked"><strong>PC portable</strong></a><strong> entrée de gamme qui coche un maximum de critères attendus en 2023, sans pour autant faire flamber l’addition, n’est pas toujours chose aisée. Avec son petit 14s, HP se livre à cet exercice délicat en cherchant visiblement surtout à fuir toute fioriture et conserver ses marges. Voyons si l’appareil a néanmoins des talents cachés.</strong></p></div></div></div><div><div><div class="div-breakable"></div></div><div class="row-wrapper row"><div data-event-cat="BestPickPage" data-event-action="click_comparatif" class="sc-1gmrn9p-0 kZuTpH">