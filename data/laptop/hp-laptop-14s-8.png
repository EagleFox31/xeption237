88-3888\",\"data-lazy\":\"{\\\"imageId\\\":2087481,\\\"className\\\":\\\"article\\\",\\\"mobileWidth\\\":5184,\\\"mobileHeight\\\":3888,\\\"desktopWidth\\\":5184,\\\"desktopHeight\\\":3888,\\\"disableRadius\\\":false,\\\"extension\\\":\\\"jpeg\\\",\\\"title\\\":\\\"HP 14s-6\\\",\\\"maxWidth\\\":5184}\",\"style\":{\"--iwm\":\"768px\",\"--ihm\":\"576px\",\"--iwt\":\"1024px\",\"--iht\":\"768px\",\"--iwd\":\"5184px\",\"--ihd\":\"3888px\"},\"children\":\"$fd\"}]}]}],null]}],null]}]}],[\"$\",\"div\",\"c6jn43\",{\"className\":\"col-wrapper col-wrapper-6\",\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"$L90\",null,{\"className\":\"image-content\",\"images\":[{\"id\":2087532,\"width\":1280,\"height\":720}],\"children\":[[\"$\",\"span\",null,{\"onClick\":\"$undefined\",\"onKeyDown\":\"$undefined\",\"onDoubleClick\":null,\"role\":\"presentation\",\"children\":[\"$\",\"div\",null,{\"style\":{\"display\":\"contents\"},\"children\":[\"$\",\"picture\",null,{\"className\":\"article img-wrapper lazy\",\"data-image-key\":\"2087532-1280-1280-720-720\",\"data-lazy\":\"{\\\"imageId\\\":2087532,\\\"className\\\":\\\"article\\\",\\\"mobileWidth\\\":1280,\\\"mobileHeight\\\":720,\\\"desktopWidth\\\":1280,\\\"desktopHeight\\\":720,\\\"disableRadius\\\":false,\\\"extension\\\":\\\"jpeg\\\",\\\"title\\\":\\\"HP 14s-23\\\",\\\"maxWidth\\\":1280}\",\"style\":{\"--iwm\":\"768px\",\"--ihm\":\"432px\",\"--iwt\":\"1024px\",\"--iht\":\"576px\",\"--iwd\":\"1280px\",\"--ihd\":\"720px\"},\"children\":\"$ff\"}]}]}],null]}],null]}]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"a4:[\"$\",\"div\",\"8k3mqw\",{\"className\":\"grid-default\",\"children\":[\"$\",\"$1\",\"8k3mqw\",{\"children\":[[\"$\",\"div\",null,{\"suppressHydrationWarning\":true,\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"div-breakable\\\"\u003e\u003c/div\u003e\"}}],[\"$\",\"div\",null,{\"className\":\"row-wrapper row\",\"children\":[[\"$\",\"div\",\"te33kw\",{\"className\":\"slate-content col-slate-12\",\"children\":[[\"$\",\"$1\",\"0\",{\"children\":[[null,[\"$\",\"$Lde\",null,{\"id\":\"index-2\",\"className\":\"$undefined\",\"children\":[[\"Écran : une dalle HD peu lumineuse aux angles de vision réduits\"]]}]],null]}],[\"$\",\"$1\",\"1\",{\"children\":[[\"$\",\"$Lc9\",null,{\"className\":\"$undefined\",\"children\":[[\"Si l’on peut se contenter (tant bien que mal) du design rudimentaire proposé par le HP 14s, il est beaucoup plus difficile de se faire à son écran. Sur ce plan, tout du moins pour notre unité de prêt, le constructeur américain a vraiment choisi ce qu’il se fait de moins cher avec une simple dalle HD (1366 × 768 pixels) LCD TN, fabriquée par le Chinois Chimei Innolux. Cette dernière profite d’une diagonale de 14 pouces au format 16:9, et d’une luminosité maximale annoncée à 250 nits par le fabricant. Ce n’est donc pas ici que l’on trouvera quoi que ce soit de radieux… et malheureusement \"],[\"$\",\"$1\",\"1\",{\"children\":[[\"$\",\"$Lca\",null,{\"href\":\"/labo-385734-comment-testons-nous-les-ecrans-pc-chez-clubic\",\"rawHref\":false,\"rel\":[],\"data-event-action\":null,\"data-event-value\":null,\"openInNewWindow\":null,\"children\":[[\"nos outils de mesure le \"]]}],null]}],[\"confirment.\"]]}],[\"$\",\"div\",null,{\"suppressHydrationWarning\":true,\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"div-breakable\\\"\u003e\u003c/div\u003e\"}}]]}],[\"$\",\"$1\",\"2\",{\"children\":[[\"$\",\"$Lc9\",null,{\"className\":\"$undefined\",\"children\":[[\"Très concrètement, la luminosité n’atteint que 236,5 cd/m2 ce qui gêne considérablement la lisibilité, tandis que le contraste se limite à un ratio tout penaud de 415:1. Les angles de vision sont quant à eux catastrophiques : il faut se tenir parfaitement en face de l’écran pour y voir quelque chose (vraiment, on n'exagère pas…).\"]]}],null]}]]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"102:[\"$\",\"img\",null,{\"src\":\"//pic.clubic.com/46197bd82087478/5184x3888/smart/hp-14s-5.jpg\",\"alt\":\"© Nathan Le Gohlisse pour Clubic\",\"width\":5184,\"height\":3888,\"loading\":\"lazy\",\"className\":\" radius\"}]\n101:[[\"$\",\"div\",null,{\"className\":\"image-loading\",\"children\":[\"$\",\"svg\",null,{\"className\":\"image-clip\",\"width\":50,\"height\":50,\"viewBox\":\"0 0 93.51 93.51\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"children\":[[\"$\",\"circle\",null,{\"fill\":\"#ff0037\",\"cx\":\"46.75\",\"cy\":\"46.75\",\"r\":\"46.75\"}],[\"$\",\"path\",null,{\"fill\":\"var(--theme-palette-white)\",\"d\":\"M46.75,63.47a16.71,16.71,0,1,1,10-30.08A6.23,6.23,0,0,0,65,32.85l5.78-5.79a31,31,0,1,0,0,39.39L65,60.66a6.21,6.21,0,0,0-8.14-.56A16.69,16.69,0,0,1,46.75,63.47Z\"}]]}]}],[\"$\",\"noscript\",null,{\"children\":\"$102\"}]]\na5:[\"$\",\"div\",\"csj0ws\",{\"children\":[\"$\",\"$1\",\"csj0ws\",{\"children\":[[\"$\",\"div\",null,{\"suppressHydrationWarning\":true,\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"div-breakable\\\"\u003e\u003c/div\u003e\"}}],[\"$\",\"div\",null,{\"className\":\"row-wrapper row\",\"children\":[[\"$\",\"div\",\"nyl8wc\",{\"children\":[[\"$\",\"$L90\",null,{\"className\":\"image-content\",\"images\":[{\"id\":2087478,\"width\":5184,\"height\":3888}],\"children\":[[\"$\",\"span\",null,{\"onClick\":\"$undefined\",\"onKeyDown\":\"$undefined\",\"onDoubleClick\":null,\"role\":\"presentation\",\"children\":[\"$\",\"div\",null,{\"style\":{\"display\":\"contents\"},\"children\":[\"$\",\"picture\",null,{\"className\":\"article img-wrapper lazy\",\"data-image-key\":\"2087478-5184-5184-3888-3888\",\"data-lazy\":\"{\\\"imageId\\\":2087478,\\\"className\\\":\\\"article\\\",\\\"mobileWidth\\\":5184,\\\"mobileHeight\\\":3888,\\\"desktopWidth\\\":5184,\\\"desktopHeight\\\":3888,\\\"disableRadius\\\":false,\\\"extension\\\":\\\"jpeg\\\",\\\"title\\\":\\\"HP 14s-5\\\",\\\"maxWidth\\\":5184}\",\"style\":{\"--iwm\":\"768px\",\"--ihm\":\"576px\",\"--iwt\":\"1024px\",\"--iht\":\"768px\",\"--iwd\":\"5184px\",\"--ihd\":\"3888px\"},\"children\":\"$101\"}]}]}],[\"$\",\"$Lc8\",null,{\"children\":\"© Nathan Le Gohlisse pour Clubic\"}]]}],null]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"a6:[\"$\",\"div\",\"nx5q91\",{\"className\":\"grid-default\",\"children\":[\"$\",\"$1\",\"nx5q91\",{\"children\":[[\"$\",\"div\",null,{\"suppressHydrationWarning\":true,\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"div-breakable\\\"\u003e\u003c/div\u003e\"}}],[\"$\",\"div\",null,{\"className\":\"row-wrapper row\",\"children\":[[\"$\",\"div\",\"f8sans\",{\"className\":\"slate-content col-slate-12\",\"children\":[[\"$\",\"$1\",\"0\",{\"children\":[[\"$\",\"$Lc9\",null,{\"className\":\"$undefined\",\"children\":[[\"Sans surprise, les couleurs ne sont pas non plus à la fête avec un DeltaE mesuré à 6,3, une température estimée à 10 585 kelvins, et une dérive très marquée vers le bleu. En théorie, le DeltaE devrait être égal ou inférieur à 3 pour offrir des couleurs justes, tandis que la température de l’écran devrait approcher les 6500 kelvins du standard vidéo. Nous en sommes très loin à tout point de vue.\"]]}],[\"$\",\"div\",null,{\"suppressHydrationWarning\":true,\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"div-breakable\\\"\u003e\u003c/div\u003e\"}}]]}],[\"$\",\"$1\",\"1\",{\"children\":[[\"$\",\"$Lc9\",null,{\"className\":\"$undefined\",\"children\":[[\"La couverture des principaux espaces colorimétriques est également de très bas niveau, avec un gamut sRGB supporté à 64,7 % seulement et un spectre DCI-P3 couvert à 47,8 %. En clair, le HP 14s n’a pas grand-chose à offrir sur le plan de l’affichage. Nous serions curieux de savoir si l’écran 1080p des moutures les mieux équipées du produit est de meilleure qualité, mais celui du modèle qui nous intéresse présentement (le plus courant d’après ce que nous avons pu observer chez les revendeurs) est tout simplement médiocre. Impossible de le dire autrement.\"]]}],null]}]]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"104:[\