8,\\\"desktopWidth\\\":5184,\\\"desktopHeight\\\":3888,\\\"disableRadius\\\":false,\\\"extension\\\":\\\"jpeg\\\",\\\"title\\\":\\\"HP 14s-17\\\",\\\"maxWidth\\\":5184}\",\"style\":{\"--iwm\":\"768px\",\"--ihm\":\"576px\",\"--iwt\":\"1024px\",\"--iht\":\"768px\",\"--iwd\":\"5184px\",\"--ihd\":\"3888px\"},\"children\":\"$107\"}]}]}],null]}],null]}]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"a9:[\"$\",\"div\",\"yg8ijc\",{\"className\":\"grid-default\",\"children\":[\"$\",\"$1\",\"yg8ijc\",{\"children\":[[\"$\",\"div\",null,{\"suppressHydrationWarning\":true,\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"div-breakable\\\"\u003e\u003c/div\u003e\"}}],[\"$\",\"div\",null,{\"className\":\"row-wrapper row\",\"children\":[[\"$\",\"div\",\"waaf4k\",{\"className\":\"slate-content col-slate-12\",\"children\":[[\"$\",\"$1\",\"0\",{\"children\":[[null,[\"$\",\"$Lde\",null,{\"id\":\"index-3\",\"className\":\"$undefined\",\"children\":[[\"Performances : un peu de puissance grâce… à Tiger Lake\"]]}]],null]}],[\"$\",\"$1\",\"1\",{\"children\":[[\"$\",\"$Lc9\",null,{\"className\":\"$undefined\",\"children\":[[\"Les performances sont le seul domaine sur lequel notre petit 14s est en tout point honorable. Il faut dire que notre modèle de prêt comptait parmi les mieux équipés en regroupant un processeur Intel Core i3-1125G4 (4 cœurs et 8 threads cadencés à un maximum de 3,70 GHz, 8 Mo de cache et 15 W de TDP), 8 Go de RAM en DDR4 à 2666 MHz et 256 Go de stockage en SSD. Avec cette configuration, l’appareil parvient à offrir une expérience très convenable pour les activités du quotidien. S’il ne déborde pas de puissance, nous n’avons jamais eu à déplorer la moindre lenteur sur l’appareil au cours de notre période d’essai.\"]]}],[\"$\",\"div\",null,{\"suppressHydrationWarning\":true,\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"div-breakable\\\"\u003e\u003c/div\u003e\"}}]]}],[\"$\",\"$1\",\"2\",{\"children\":[[\"$\",\"$Lc9\",null,{\"className\":\"$undefined\",\"children\":[[\"Pour faire simple, le 14s se destine ostensiblement à une utilisation bureautique et multimédia léger — et il s’en donne les moyens avec son Core i3 Tiger Lake. Bien qu’un peu datée, le CPU d’Intel (lancée en 2021), parvient à développer un niveau de performances largement suffisant pour travailler la journée et regarder sa série préférée le soir. D’ailleurs, sur Cinebench R23, la petite puce ne démérite pas, récoltant 4 085 points en calcul multi-core et 1079 points en single-core. Pour comparaison, le Core i5-1135G7 du \"],[\"$\",\"$1\",\"1\",{\"children\":[[\"$\",\"$Lca\",null,{\"href\":\"/framework/test-produit-413277-test-framework-laptop-l-ultraportable-qui-mise-tout-sur-la-reparabilite.html\",\"rawHref\":false,\"rel\":[],\"data-event-action\":null,\"data-event-value\":null,\"openInNewWindow\":null,\"children\":[[\"Framework Laptop\"]]}],null]}],[\" parvenait pour sa part à cumuler 4 801 points en calcul multi-core contre 1302 points en single-core… sur un produit vendu environ trois fois plus cher.\"]]}],null]}]]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"10a:[\"$\",\"img\",null,{\"src\":\"//pic.clubic.com/ec1f57722087472/5184x3888/smart/hp-14s-3.jpg\",\"alt\":\"© Nathan Le Gohlisse pour Clubic\",\"width\":5184,\"height\":3888,\"loading\":\"lazy\",\"className\":\" radius\"}]\n109:[[\"$\",\"div\",null,{\"className\":\"image-loading\",\"children\":[\"$\",\"svg\",null,{\"className\":\"image-clip\",\"width\":50,\"height\":50,\"viewBox\":\"0 0 93.51 93.51\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"children\":[[\"$\",\"circle\",null,{\"fill\":\"#ff0037\",\"cx\":\"46.75\",\"cy\":\"46.75\",\"r\":\"46.75\"}],[\"$\",\"path\",null,{\"fill\":\"var(--theme-palette-white)\",\"d\":\"M46.75,63.47a16.71,16.71,0,1,1,10-30.08A6.23,6.23,0,0,0,65,32.85l5.78-5.79a31,31,0,1,0,0,39.39L65,60.66a6.21,6.21,0,0,0-8.14-.56A16.69,16.69,0,0,1,46.75,63.47Z\"}]]}]}],[\"$\",\"noscript\",null,{\"children\":\"$10a\"}]]\naa:[\"$\",\"div\",\"q0m6ly\",{\"children\":[\"$\",\"$1\",\"q0m6ly\",{\"children\":[[\"$\",\"div\",null,{\"suppressHydrationWarning\":true,\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"div-breakable\\\"\u003e\u003c/div\u003e\"}}],[\"$\",\"div\",null,{\"className\":\"row-wrapper row\",\"children\":[[\"$\",\"div\",\"k35kf4\",{\"children\":[[\"$\",\"$L90\",null,{\"className\":\"image-content\",\"images\":[{\"id\":2087472,\"width\":5184,\"height\":3888}],\"children\":[[\"$\",\"span\",null,{\"onClick\":\"$undefined\",\"onKeyDown\":\"$undefined\",\"onDoubleClick\":null,\"role\":\"presentation\",\"children\":[\"$\",\"div\",null,{\"style\":{\"display\":\"contents\"},\"children\":[\"$\",\"picture\",null,{\"className\":\"article img-wrapper lazy\",\"data-image-key\":\"2087472-5184-5184-3888-3888\",\"data-lazy\":\"{\\\"imageId\\\":2087472,\\\"className\\\":\\\"article\\\",\\\"mobileWidth\\\":5184,\\\"mobileHeight\\\":3888,\\\"desktopWidth\\\":5184,\\\"desktopHeight\\\":3888,\\\"disableRadius\\\":false,\\\"extension\\\":\\\"jpeg\\\",\\\"title\\\":\\\"HP 14s-3\\\",\\\"maxWidth\\\":5184}\",\"style\":{\"--iwm\":\"768px\",\"--ihm\":\"576px\",\"--iwt\":\"1024px\",\"--iht\":\"768px\",\"--iwd\":\"5184px\",\"--ihd\":\"3888px\"},\"children\":\"$109\"}]}]}],[\"$\",\"$Lc8\",null,{\"children\":\"© Nathan Le Gohlisse pour Clubic\"}]]}],null]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"ab:[\"$\",\"div\",\"zb7j4e\",{\"className\":\"grid-default\",\"children\":[\"$\",\"$1\",\"zb7j4e\",{\"children\":[[\"$\",\"div\",null,{\"suppressHydrationWarning\":true,\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"div-breakable\\\"\u003e\u003c/div\u003e\"}}],[\"$\",\"div\",null,{\"className\":\"row-wrapper row\",\"children\":[[\"$\",\"div\",\"qjcn7y\",{\"className\":\"slate-content col-slate-12\",\"children\":[[\"$\",\"$1\",\"0\",{\"children\":[[\"$\",\"$Lc9\",null,{\"className\":\"$undefined\",\"children\":[[\"Côté chauffe et refroidissement, le constat est un peu plus nuancé. En stress test sous AIDA64 nous avons relevé 3,00 à 3,05 GHz en début de charge CPU à 100 %, avec une température s’élevant dans ce contexte à 85-90 degrés environ. Le déclenchement du ventilateur intervenait alors rapidement pour donner lieu à une baisse des températures jusqu’à 65 degrés environ. En contrepartie, les fréquences retombaient alors à 2,50-2,60 GHz sans qu’un phénomène de thermal throtting trop marqué n’apparaisse. \"]]}],[\"$\",\"div\",null,{\"suppressHydrationWarning\":true,\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"div-breakable\\\"\u003e\u003c/div\u003e\"}}]]}],[\"$\",\"$1\",\"1\",{\"children\":[[\"$\",\"$Lc9\",null,{\"className\":\"$undefined\",\"children\":[[\"En dépit des températures élevées observées en début de stress test, nous n’avons pas constaté de chaleur réellement notable au toucher sur le châssis. En revanche, le ventilateur se montre très audible, et même pénible à la longue. Il se déclenche par ailleurs trop fréquemment en cours d’utilisation, même modeste, du HP 14s. Dommage : nous sommes sur une puce basse consommation de 15W, et avec une meilleure gestion thermique, le petit ultraportable de HP aurait pu être beaucoup plus silencieux.\"]]}],null]}]]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"10c:[\"$\",\"img\",null,{\"src\":\"//pic.clubic.com/52f803a82087526/1197x633/smart/hp-14s-21.jpg\",\"alt\":\"HP 14s-21\",\"width\":1197,\"height\":633,\"loading\":\"lazy\",\"className\":\" radius\"}]\n10b:[[\"$\",\"div\",null,{\"className\":\"image-loading\",\"children\":[\"$\",\"svg\",null,{\"className\":\"image-clip\",\"width\":50,\"height\":50,\"viewBox\":\"0 0 93.51 93.51\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"children\":[[\"$\",\"circle\",null,{\"fill\":\"#ff0037\",\"cx\":\"46.75\",\"cy\":\"46.75\",\"r\":\"46.75\"}],[\"$\",\"path\",null,{\"fill\":\"var(--theme-palette-white)\",\"d\":\"M46.75,63.47a16.71,16.71,0,1,1,10-30.08A6.23,6.23,0,0,0,65,32.85l5.78-5.79a31,31,0,1,0,0,39.39L65,60.66a6.21,6.21,0,0,0-8.14-.56A16.69,16.69,