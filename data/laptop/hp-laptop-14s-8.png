etInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"div-breakable\\\"\u003e\u003c/div\u003e\"}}]]}],[\"$\",\"$1\",\"1\",{\"children\":[[\"$\",\"$Lc9\",null,{\"className\":\"$undefined\",\"children\":[[\"S’il débute à un prix très contenu, le HP 14s peut donc monter à des tarifs approchant le milieu de gamme. Un point que nous avons pris en compte dans notre évolution du produit.\"]]}],null]}]]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"eb:[[[\"$\",\"source\",\"[object Object],[object Object](max-width: 768px)image/webp\",{\"media\":\"(max-width: 768px)\",\"sizes\":\"768px\",\"type\":\"image/webp\",\"srcSet\":\"//pic.clubic.com/386d11122087496/768x576/smart/hp-14s-11.webp 2x, //pic.clubic.com/ba5771a42087496/1152x864/smart/hp-14s-11.webp 3x\"}],[\"$\",\"source\",\"[object Object],[object Object](min-width: 769px) and (max-width: 1024px)image/webp\",{\"media\":\"(min-width: 769px) and (max-width: 1024px)\",\"sizes\":\"1024px\",\"type\":\"image/webp\",\"srcSet\":\"//pic.clubic.com/7f36bd932087496/1024x768/smart/hp-14s-11.webp 1x, //pic.clubic.com/2fff25112087496/1536x1152/smart/hp-14s-11.webp 2x\"}],[\"$\",\"source\",\"[object Object](min-width: 1025px)image/webp\",{\"media\":\"(min-width: 1025px)\",\"sizes\":\"5184px\",\"type\":\"image/webp\",\"srcSet\":\"//pic.clubic.com/255888692087496/1600x1200/smart/hp-14s-11.webp 1x\"}],[\"$\",\"source\",\"[object Object],[object Object](max-width: 768px)undefined\",{\"media\":\"(max-width: 768px)\",\"sizes\":\"768px\",\"type\":\"$undefined\",\"srcSet\":\"//pic.clubic.com/2ba096352087496/768x576/smart/hp-14s-11.jpg 2x, //pic.clubic.com/081853112087496/1152x864/smart/hp-14s-11.jpg 3x\"}],[\"$\",\"source\",\"[object Object],[object Object](min-width: 769px) and (max-width: 1024px)undefined\",{\"media\":\"(min-width: 769px) and (max-width: 1024px)\",\"sizes\":\"1024px\",\"type\":\"$undefined\",\"srcSet\":\"//pic.clubic.com/c3ec2d522087496/1024x768/smart/hp-14s-11.jpg 1x, //pic.clubic.com/2ba80c112087496/1536x1152/smart/hp-14s-11.jpg 2x\"}],[\"$\",\"source\",\"[object Object](min-width: 1025px)undefined\",{\"media\":\"(min-width: 1025px)\",\"sizes\":\"5184px\",\"type\":\"$undefined\",\"srcSet\":\"//pic.clubic.com/55f6b89c2087496/1600x1200/smart/hp-14s-11.jpg 1x\"}]],[\"$\",\"img\",null,{\"src\":\"//pic.clubic.com/8946028d2087496/5184x3888/smart/hp-14s-11.jpg\",\"alt\":\"© Nathan Le Gohlisse pour Clubic\",\"loading\":\"eager\",\"className\":\"radius\"}]]\n"])</script><script>self.__next_f.push([1,"99:[\"$\",\"div\",\"ln2gro\",{\"children\":[\"$\",\"$1\",\"ln2gro\",{\"children\":[[\"$\",\"div\",null,{\"suppressHydrationWarning\":true,\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"div-breakable\\\"\u003e\u003c/div\u003e\"}}],[\"$\",\"div\",null,{\"className\":\"row-wrapper row\",\"children\":[[\"$\",\"div\",\"rtz2eg\",{\"children\":[[\"$\",\"$L90\",null,{\"className\":\"image-content\",\"images\":[{\"id\":2087496,\"width\":5184,\"height\":3888}],\"children\":[[\"$\",\"span\",null,{\"onClick\":\"$undefined\",\"onKeyDown\":\"$undefined\",\"onDoubleClick\":null,\"role\":\"presentation\",\"children\":[\"$\",\"div\",null,{\"style\":{\"display\":\"contents\"},\"children\":[\"$\",\"picture\",null,{\"className\":\"article img-wrapper\",\"data-image-key\":\"2087496-5184-5184-3888-3888\",\"data-lazy\":null,\"style\":{\"--iwm\":\"768px\",\"--ihm\":\"576px\",\"--iwt\":\"1024px\",\"--iht\":\"768px\",\"--iwd\":\"5184px\",\"--ihd\":\"3888px\"},\"children\":\"$eb\"}]}]}],[\"$\",\"$Lc8\",null,{\"children\":\"© Nathan Le Gohlisse pour Clubic\"}]]}],null]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"9a:[\"$\",\"$1\",\"x3fdhh\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"nav-item-index\",\"children\":[\"$\",\"$Lec\",null,{\"links\":[{\"href\":\"#index-1\",\"label\":\"Design : du plastique, du plastique et encore du plastique\",\"deepness\":1},{\"href\":\"#index-2\",\"label\":\"Écran : une dalle HD peu lumineuse aux angles de vision réduits\",\"deepness\":1},{\"href\":\"#index-3\",\"label\":\"Performances : un peu de puissance grâce… à Tiger Lake\",\"deepness\":1},{\"href\":\"#index-4\",\"label\":\"Autonomie : la journée de travail sur batterie, c'est possible ?\",\"deepness\":1},{\"href\":\"#index-5\",\"label\":\"Audio : circulez, y’a rien d’intéressant à entendre\",\"deepness\":1},{\"href\":\"#index-6\",\"label\":\"HP 14s, l’avis de Clubic : \",\"deepness\":1},{\"href\":\"#index-7\",\"label\":\"Concurrence : quelles alternatives au HP 14s\",\"deepness\":1}]}]}],[\"$\",\"div\",null,{\"className\":\"grid-default\",\"children\":[\"$\",\"$1\",\"x3fdhh\",{\"children\":[[\"$\",\"div\",null,{\"suppressHydrationWarning\":true,\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"div-breakable\\\"\u003e\u003c/div\u003e\"}}],[\"$\",\"div\",null,{\"className\":\"row-wrapper row\",\"children\":[[\"$\",\"div\",\"ohe0ga\",{\"className\":\"slate-content col-slate-12\",\"children\":[[\"$\",\"$1\",\"0\",{\"children\":[[null,[\"$\",\"$Lde\",null,{\"id\":\"index-1\",\"className\":\"$undefined\",\"children\":[[\"Design : du plastique, du plastique et encore du plastique\"]]}]],null]}],[\"$\",\"$1\",\"1\",{\"children\":[[\"$\",\"$Lc9\",null,{\"className\":\"$undefined\",\"children\":[[\"Nous irons vite sur le design du 14s, parce qu’il n’y a malheureusement pas grand-chose d’intéressant à regarder… et donc pas grand-chose à dire. L’appareil est l’archétype du PC portable basique, entièrement vêtu d’un plastique noir texturé (une variante blanche existe). On ne peut pas dire qu’il y ait ici une quelconque volonté d’esthétisme. HP fait le minimum syndical pour proposer un produit fonctionnel sans prendre le moindre risque ou une quelconque initiative qui pourrait rendre l’appareil un peu plus attirant qu’il ne l’est.\"]]}],[\"$\",\"div\",null,{\"suppressHydrationWarning\":true,\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cdiv class=\\\"div-breakable\\\"\u003e\u003c/div\u003e\"}}]]}],[\"$\",\"$1\",\"2\",{\"children\":[[\"$\",\"$Lc9\",null,{\"className\":\"$undefined\",\"children\":[[\"On arguera toutefois que la conception du 14s est plutôt robuste et que la qualité d’assemblage est honnête en dépit de matériaux tout sauf nobles. Avec 32.4 × 22.5 × 1,79 cm pour 1,46 kg, l’engin est pour le reste compact sans néanmoins chercher la finesse ou une légèreté particulière. Du basique donc, c’est vraiment le mot à garder en tête ici.\"]]}],null]}]]}]]}]]}]}]]}]\n"])</script><script>self.__next_f.push([1,"ee:[\"$\",\"img\",null,{\"src\":\"//pic.clubic.com/3c38df642087475/5184x3888/smart/hp-14s-4.jpg\",\"alt\":\"HP 14s-4\",\"width\":5184,\"height\":3888,\"loading\":\"lazy\",\"className\":\" radius\"}]\ned:[[\"$\",\"div\",null,{\"className\":\"image-loading\",\"children\":[\"$\",\"svg\",null,{\"className\":\"image-clip\",\"width\":50,\"height\":50,\"viewBox\":\"0 0 93.51 93.51\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"children\":[[\"$\",\"circle\",null,{\"fill\":\"#ff0037\",\"cx\":\"46.75\",\"cy\":\"46.75\",\"r\":\"46.75\"}],[\"$\",\"path\",null,{\"fill\":\"var(--theme-palette-white)\",\"d\":\"M46.75,63.47a16.71,16.71,0,1,1,10-30.08A6.23,6.23,0,0,0,65,32.85l5.78-5.79a31,31,0,1,0,0,39.39L65,60.66a6.21,6.21,0,0,0-8.14-.56A16.69,16.69,0,0,1,46.75,63.47Z\"}]]}]}],[\"$\",\"noscript\",null,{\"children\":\"$ee\"}]]\nf0:[\"$\",\"img\",null,{\"src\":\"//pic.clubic.com/09f44c892087505/5184x3888/smart/hp-14s-14.jpg\",\"alt\":\"HP 14s-14\",\"width\":5184,\"height\":3888,\"loading\":\"lazy\",\"className\":\" radius\"}]\nef:[[\"$\",\"div\",null,{\"className\":\"image-loading\",\"children\":[\"$\",\"svg\",null,{\"className\":\"image-clip\",\"width\":50,\"height\":50,\"viewBox\":\"0 0 93.51 93.51\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"children\":[[\"$\",\"circle\",null,{\"fill\":\"#ff0037\",\"cx\":\"46.75\",\"cy\":\"46.75\",\"r\":\"46.75\"}],[\"$\",\"path\",null,{\"fill\":\"var(--theme-palette-white)\",\"d\":\"M46.75,63.47a16.71,16.71,0,1,1,10-30.08A6.23,6.23,0,0,0,65,32.85l5.78-5.79a31,31,0,1,0,0,39.39L65,60.66a6.21,6.21,0,0,0-8